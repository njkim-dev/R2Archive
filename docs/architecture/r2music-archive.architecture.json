  "cards": [
    {
      "dot": "cyan",
      "title": "Traffic & Mode",
      "items": [
        "music.r2archive.com and xyx.r2archive.com share one React build",
        "Hostname selects KR or XYX API paths; Caddy keeps API same-origin",
        "HTML is no-cache; hashed assets are immutable"
      ]
    },
    {
      "dot": "emerald",
      "title": "Application",
      "items": [
        "FastAPI exposes catalog, records, rankings, groups, categories and analytics",
        "KR, XYX and PMANG routers share auth and database infrastructure",
        "Screenshot score parsing runs through a bounded Tesseract worker path"
      ]
    },
    {
      "dot": "rose",
      "title": "Security",
      "items": [
        "HttpOnly JWT session cookie is shared across r2archive.com subdomains",
        "Kakao, Naver and Google callbacks terminate at FastAPI",
        "Caddy applies CSP/security headers; slowapi limits sensitive endpoints"
      ]
    },
    {
      "dot": "amber",
      "title": "Data & Media",
      "items": [
        "PostgreSQL runs outside this Compose service and is reached through an env-configured pool",
        "KR, XYX and PMANG artwork mounts are read-only",
        "Record screenshots use a writable persistent NAS mount"
      ]
    }
  ]
