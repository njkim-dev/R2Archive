:3000

encode gzip

header {
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
    Cross-Origin-Opener-Policy "same-origin"
}

# 스크린샷 업로드(500KB~2MB)를 고려해 10MB까지 허용.
request_body {
    max_size 10MB
}

# API 및 정적 이미지 요청은 FastAPI로 프록시
@backend path /api/* /static/*
handle @backend {
    reverse_proxy localhost:8000 {
        # 외부에서 위조한 X-Forwarded-For를 제거하고 Caddy가 본 실제 client IP만 설정.
        # rate_limit.py가 XFF 첫 항목을 신뢰하므로, 이 처리 없이는 클라이언트가 헤더를 직접 박아 IP rate limit 우회 가능.
        header_up -X-Forwarded-For
        header_up X-Forwarded-For {remote_host}
    }
}

# React SPA
root * /srv
route {
    try_files {path} {path}/ /index.html
    file_server
}
