{
	servers {
		timeouts {
			read_body 60s
			read_header 10s
			write 60s
			idle 30s
		}
		max_header_size 32KB
	}
}

:3000

encode gzip

header {
	X-Content-Type-Options "nosniff"
	X-Frame-Options "DENY"
	Referrer-Policy "strict-origin-when-cross-origin"
	Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
	Cross-Origin-Opener-Policy "same-origin"
	Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://www.youtube.com https://fonts.googleapis.com https://fonts.gstatic.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self' https://accounts.google.com https://kauth.kakao.com https://nid.naver.com"
}

# 스크린샷 업로드(500KB~2MB)를 고려해 10MB까지 허용.
request_body {
	max_size 10MB
}

# 존재하지 않는 민감/운영 경로를 SPA 진입 문서로 위장해 반환하지 않는다.
@blocked_paths path /.env /.git/* /.well-known/security.txt /robots.txt /server-status /nginx_status /metrics /docs /openapi.json /swagger /swagger/* /api/docs /api/openapi.json /api/swagger /api/swagger/*
handle @blocked_paths {
	respond 404
}

# 정적 이미지는 Caddy가 직접 제공하고 브라우저에 일주일 동안 보관한다.
handle_path /static/rnr_image/* {
	root * /app/rnr_image
	header Cache-Control "public, max-age=604800"
	file_server
}

handle_path /static/xyx/rnr_image/* {
	root * /app/xyx/rnr_image
	header Cache-Control "public, max-age=604800"
	file_server
}

handle_path /static/pmang_image/* {
	root * /app/pmang_image
	header Cache-Control "public, max-age=604800"
	file_server
}

# API 요청은 FastAPI로 프록시
@api path /api/*
handle @api {
	reverse_proxy localhost:8000 {
		# NAS nginx가 외부 XFF를 제거하고 실제 remote_addr 하나만 전달한다.
		# Docker 포트는 loopback 전용이므로 이 헤더를 신뢰해 애플리케이션 rate limit에 전달한다.
		header_up -X-Forwarded-For
		header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
		header_up -X-Forwarded-Host
	}
}

handle /assets/* {
	root * /srv
	header Cache-Control "public, max-age=31536000, immutable"
	try_files {path} =404
	file_server
}

# React SPA
handle {
	root * /srv
	header Cache-Control "no-cache"
	try_files {path} {path}/ /index.html
	file_server
}
