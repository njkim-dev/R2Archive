{
	servers {
		timeouts {
			read_body 60s
			read_header 10s
			write 60s
			idle 30s
		}
		max_header_size 32KB
	}
}

:3000

encode gzip

header {
	X-Content-Type-Options "nosniff"
	X-Frame-Options "DENY"
	Referrer-Policy "strict-origin-when-cross-origin"
	Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
	Cross-Origin-Opener-Policy "same-origin"
	Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://www.youtube.com https://fonts.googleapis.com https://fonts.gstatic.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self' https://accounts.google.com https://kauth.kakao.com https://nid.naver.com"
}

# 스크린샷 업로드(500KB~2MB)를 고려해 10MB까지 허용.
request_body {
	max_size 10MB
}

@discovery path /robots.txt /sitemap.xml
handle @discovery {
	@kr host music.r2archive.com
	handle @kr {
		root * /srv/seo/kr
		header Cache-Control "public, max-age=3600"
		file_server
	}
	handle {
		respond 404
	}
}

# 존재하지 않는 민감/운영 경로를 SPA 진입 문서로 위장해 반환하지 않는다.
@blocked_paths path /.env /.git/* /.well-known/security.txt /seo /seo/* /server-status /nginx_status /metrics /docs /openapi.json /swagger /swagger/* /api/docs /api/openapi.json /api/swagger /api/swagger/*
handle @blocked_paths {
	respond 404
}

# 정적 이미지는 Caddy가 직접 제공하고 브라우저에 일주일 동안 보관한다.
handle_path /static/rnr_image/* {
	root * /app/rnr_image
	@existingKr file
	header @existingKr Cache-Control "public, max-age=604800"
	file_server
}

handle_path /static/xyx/rnr_image/* {
	root * /app/xyx/rnr_image
	@existingXyx file
	header @existingXyx Cache-Control "public, max-age=604800"
	file_server
}

handle_path /static/pmang_image/* {
	root * /app/pmang_image
	@existingPmang file
	header @existingPmang Cache-Control "public, max-age=604800"
	file_server
}

@api path /api/*
handle @api {
	reverse_proxy {$API_UPSTREAM} {
		# 신뢰된 외부 프록시가 전달한 단일 클라이언트 주소를 애플리케이션에 전달한다.
		header_up -X-Forwarded-For
		header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
		header_up -X-Forwarded-Host
	}
}

handle /assets/* {
	root * /srv
	header Cache-Control "public, max-age=31536000, immutable"
	try_files {path} =404
	file_server
}

handle {
	root * /srv
	header Cache-Control "no-cache"
	@kr_home {
		host music.r2archive.com
		path / /index.html
	}
	@kr_pmang {
		host music.r2archive.com
		path /pmang-songs /pmang-songs/
	}
	@kr_nonpublic {
		host music.r2archive.com
		not path / /index.html /pmang-songs /pmang-songs/
	}
	header @kr_nonpublic X-Robots-Tag "noindex"
	route {
		rewrite @kr_home /seo/kr/home.html
		rewrite @kr_pmang /seo/kr/pmang.html
		try_files {path} {path}/ /index.html
		file_server
	}
}
